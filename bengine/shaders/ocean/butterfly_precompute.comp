#version 430 core

// Precomputes the butterfly (twiddle + input indices) texture for a radix-2 FFT,
// following the classic Flugge GPU FFT layout. Texture size: LOG_N x N.
//   .xy = twiddle factor, .z = first input index, .w = second input index.
// Stage 0 bakes in the bit-reversal permutation.

layout(local_size_x = 1, local_size_y = 16) in;
layout(rgba32f, binding = 0) uniform writeonly image2D butterfly;

uniform int N;

const float PI = 3.14159265358979;

int reverseBitsN(int x, int bits) {
	int r = 0;
	for (int i = 0; i < bits; i++) {
		r = (r << 1) | (x & 1);
		x >>= 1;
	}
	return r;
}

void main() {
	ivec2 id = ivec2(gl_GlobalInvocationID.xy); // x = stage, y = index row
	int stage = id.x;
	int y     = id.y;
	int logN  = int(round(log2(float(N))));

	float span2  = pow(2.0, float(stage + 1));
	float k      = mod(float(y) * (float(N) / span2), float(N));
	vec2  twiddle = vec2(cos(2.0 * PI * k / float(N)), sin(2.0 * PI * k / float(N)));

	int span = int(pow(2.0, float(stage)));
	bool topWing = mod(float(y), span2) < float(span);

	int idx1, idx2;
	if (stage == 0) {
		if (topWing) {
			idx1 = reverseBitsN(y,     logN);
			idx2 = reverseBitsN(y + 1, logN);
		} else {
			idx1 = reverseBitsN(y - 1, logN);
			idx2 = reverseBitsN(y,     logN);
		}
	} else {
		if (topWing) {
			idx1 = y;
			idx2 = y + span;
		} else {
			idx1 = y - span;
			idx2 = y;
		}
	}

	imageStore(butterfly, id, vec4(twiddle, float(idx1), float(idx2)));
}
